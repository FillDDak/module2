{
  "name": "gridclip",
  "version": "1.0.0",
  "description": "Spreadsheet-grade copy & paste for web apps: read and write the clipboard formats of Excel, Google Sheets, LibreOffice, Word and the web, merged cells included. Zero dependencies, runs anywhere.",
  "keywords": [
    "clipboard",
    "copy",
    "paste",
    "excel",
    "google-sheets",
    "spreadsheet",
    "tsv",
    "csv",
    "html-table",
    "table",
    "grid",
    "data-grid",
    "datagrid",
    "merged-cells",
    "colspan",
    "rowspan",
    "libreoffice",
    "clipboard-api"
  ],
  "license": "MIT",
  "author": "FillDDak (https://github.com/FillDDak)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FillDDak/module2.git"
  },
  "bugs": {
    "url": "https://github.com/FillDDak/module2/issues"
  },
  "homepage": "https://github.com/FillDDak/module2#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/gridclip.global.js",
  "jsdelivr": "./dist/gridclip.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README.ko.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "npm run build && node --test test/browser/",
    "test:env": "npm run build && node test/env/smoke.mjs && node test/env/smoke.cjs",
    "test:types": "npm run build && tsc -p test/types/tsconfig.json && tsc -p test/types/tsconfig.bundler.json && tsc -p test/types/tsconfig.cjs.json",
    "lint:package": "npm run build && publint --strict && attw --pack .",
    "check": "npm run typecheck && npm test && npm run test:env && npm run test:types && npm run test:browser && publint --strict && attw --pack .",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "playwright": "1.56",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
